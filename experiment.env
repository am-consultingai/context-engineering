# Experiment configuration. Sourced by every script. Override any value per run
# with flags (e.g. ./run.sh --model sonnet) or by exporting the variable.

# The Saleor workspace the envs are built from: the context pack (CLAUDE.md, arch/, .claude/),
# the workspace overlay, and children.lock (the pinned commit of each Saleor repo).
# Default: setup.sh downloads it (public repos) into a cache folder; nothing to clone by hand.
# To build from an existing local checkout instead, export SOURCE_WORKSPACE=<path>. setup.sh only
# reads it, so it must already contain SOURCE_REF and the pinned commits of the 4 child repos.
SOURCE_REPO_URL="${SOURCE_REPO_URL:-https://github.com/am-consultingai/Saleor-workspace.git}"
CHILD_REPO_URL_BASE="${CHILD_REPO_URL_BASE:-https://github.com/saleor}"   # <base>/<repo>.git
MANAGED_SOURCE="${XDG_CACHE_HOME:-$HOME/.cache}/context-engineering/Saleor-workspace"
SOURCE_WORKSPACE="${SOURCE_WORKSPACE:-$MANAGED_SOURCE}"
# Workspace commit to build from. Pinned so every machine gets the same context pack and the
# same children.lock; move it on purpose when the pack changes (the patches below must still apply).
SOURCE_REF="${SOURCE_REF:-7dc5044d2a40878880dd05433dd6e53dcbf051eb}"   # main @ 2026-11-25: audited pack

# The ONLY difference between the two envs: these overlay paths exist in "with", not in "without".
CONTEXT_PATHS="${CONTEXT_PATHS:-CLAUDE.md arch .claude}"
# Removed from BOTH envs: experiment plumbing / docs that describe the expected answer.
EXCLUDE_PATHS="${EXCLUDE_PATHS:-DEMO-RUNBOOK.md EXPERIMENT.md plan_*.md prompt.txt reset-children.sh children.lock}"

# The experiment is ALL context vs NO context:
#   without = code only: no workspace pack (CONTEXT_PATHS) AND none of the agent docs the Saleor
#             repos ship themselves (UPSTREAM_AGENT_DOCS, deleted by setup; each repo is rewritten
#             to a single commit so git can't bring them back)
#   with    = everything: the workspace pack + the repos exactly as pinned upstream (docs included)
# <repo>:<path> entries. Setup fails if a listed path doesn't exist (catches typos/upstream moves).
UPSTREAM_AGENT_DOCS="${UPSTREAM_AGENT_DOCS:-\
saleor:AGENTS.md saleor:CLAUDE.md saleor:saleor/graphql/AGENTS.md saleor:saleor/graphql/CLAUDE.md saleor:.claude \
saleor-dashboard:AGENTS.md saleor-dashboard:CLAUDE.md saleor-dashboard:WARP.md saleor-dashboard:.claude \
saleor-dashboard:src/components/ConditionalFilter/AGENTS.md saleor-dashboard:src/components/ConditionalFilter/CLAUDE.md \
saleor-dashboard:src/components/ResponsiveTable/AGENTS.md \
storefront:AGENTS.md storefront:.cursorrules storefront:.cursor storefront:skills}"

# Doc fix for 'with' (and 'guided'): upstream docs with known factual errors are removed from
# those envs too, and the pack is patched with corrected replacements.
#   saleor/graphql/AGENTS.md (+ its CLAUDE.md symlink) gives a schema command that doesn't
#   exist (`manage.py graphql_schema --schema ...`; the real one is `poe build-schema`).
#   Wrong since the file was created upstream (saleor fb59f151c, 2026-03-05); still on main.
# Every entry must also be in UPSTREAM_AGENT_DOCS. Set to "" to keep upstream docs untouched.
FLAWED_UPSTREAM_DOCS="${FLAWED_UPSTREAM_DOCS-saleor:saleor/graphql/AGENTS.md saleor:saleor/graphql/CLAUDE.md}"
# Line-level fixes to the upstream agent docs the context conditions keep: one <repo>.patch per
# child repo in this folder (paths relative to the repo root; may only touch UPSTREAM_AGENT_DOCS
# paths, which setup verifies). Each fix corrects a claim that is false at the pinned commit.
UPSTREAM_DOC_PATCHES="${UPSTREAM_DOC_PATCHES-agent-config/upstream-doc-fixes}"

# Agent model (alias like haiku/sonnet/opus or a full model id). Same model for both agents.
# Use the FULL id for Haiku: in plan mode the `haiku` alias silently runs Sonnet (verified 2026-11-24, CLI 2.1.331).
MODEL="${MODEL:-claude-haiku-5-5}"
# plan = read-only planning (default). implement = agents may edit files and run commands.
MODE="${MODE:-plan}"
# Repeats per run (each repeat resets both envs and runs both agents in parallel).
RUNS_PER_EXPERIMENT="${RUNS_PER_EXPERIMENT:-1}"
# Hard wall-clock limit per agent turn, in minutes.
TIMEOUT_MIN="${TIMEOUT_MIN:-30}"
# Per-turn cap on the API-equivalent cost estimate (claude --max-budget-usd). On a subscription
# nothing is billed; this just stops runaway turns. With an API key it is real spend.
MAX_BUDGET_USD="${MAX_BUDGET_USD:-5}"

# Conditions, in launch order. without = no context; guided = full context (pack + the repos'
# own agent docs) + the usage guidance in agent-config/guidance.md. 'with' (the same context,
# no guidance block) is also available: CONDITIONS="without with guided".
CONDITIONS="${CONDITIONS:-without guided}"

# The task both agents get. task/prompt.txt = natural request (default);
# task/prompt-guided.txt = the original prompt that also lists the traps to look for.
TASK_FILE="${TASK_FILE:-task/prompt.txt}"

# Where the agents' workspaces live. Deliberately OUTSIDE this harness and with neutral
# names, so an agent's working dir / plan-file path never reveals the experiment or its
# condition. Each env is $LAB_ROOT/<random label>/saleor-workspace; the label->condition
# mapping is kept only in agent-config/generated/labels.env.
LAB_ROOT="${LAB_ROOT:-$HOME/.local/share/saleor-ws}"
